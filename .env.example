# Przyklad zmiennych srodowiskowych. Skopiuj do .env i dostosuj w razie potrzeby.
# Domyslnie docker-compose.yaml ma wartosci wpisane na stale (DEMO),
# wiec ten plik jest opcjonalny i sluzy jako sciagawka konfiguracyjna.

# --- PostgreSQL ---
POSTGRES_USER=typer
POSTGRES_PASSWORD=typerpass
POSTGRES_DB=typer

# --- Backend ---
DATABASE_URL=postgresql+psycopg2://typer:typerpass@postgres:5432/typer
REDIS_URL=redis://redis:6379/0
REDIS_CHANNEL=match_finished

# --- OAuth 2.0 / Zitadel ---
OIDC_ISSUER=http://localhost:8080
OIDC_JWKS_URL=http://zitadel:8080/oauth/v2/keys
OIDC_AUDIENCE=typercloud
OIDC_ROLES_CLAIM=urn:zitadel:iam:org:project:roles

# --- Frontend ---
API_URL=http://backend:8000
OIDC_CLIENT_ID=375085643967037445
OIDC_REDIRECT_URI=http://localhost:8501/
OIDC_SCOPE=openid profile email urn:zitadel:iam:org:project:roles

# --- Zitadel masterkey (DOKLADNIE 32 znaki) ---
ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Character!
